[Unit]
Description=polymarket propose-only Hermes brain (paper/shadow)
After=network-online.target polymarket-ingestion.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=polybot-hermes
Group=polybot-hermes
SupplementaryGroups=polybot-proposal
WorkingDirectory=/var/lib/polybot-hermes
Environment=HOME=/var/lib/polybot-hermes
Environment=PYTHONPATH=/opt/polymarket-bot/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/local/lib/hermes-agent/venv/bin/python -m polybot.hermes.profile_verify --profile-home /var/lib/polybot-hermes/.hermes/profiles/polymarket
ExecStart=/usr/local/bin/hermes --profile polymarket gateway run --replace
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
KillSignal=SIGTERM
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/polymarket-bot /usr/local/lib/hermes-agent /usr/local/bin/hermes
ReadWritePaths=/var/lib/polybot-hermes
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
