[Unit]
Description=polymarket propose-only Hermes brain (paper/shadow)
After=network-online.target polymarket-ingestion.service
Wants=network-online.target
Requisite=polymarket-ingestion.service
PartOf=polymarket-ingestion.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
SupplementaryGroups=polybot-proposal
WorkingDirectory=/root/.hermes/profiles/polymarket
Environment=HOME=/root
Environment=PYTHONPATH=/opt/polymarket-bot/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HERMES_KANBAN_DISPATCH_IN_GATEWAY=0
ExecStartPre=/usr/bin/test -S /run/polybot-proposal/proposal.sock
ExecStartPre=/usr/local/lib/hermes-agent/venv/bin/python -m polybot.hermes.profile_verify --profile-home /root/.hermes/profiles/polymarket
ExecStart=/usr/local/lib/hermes-agent/venv/bin/python -m polybot.hermes.profile_gateway --profile-home /root/.hermes/profiles/polymarket
ExecStop=/usr/local/lib/hermes-agent/venv/bin/python -m polybot.hermes.profile_stop --profile-home /root/.hermes/profiles/polymarket
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
# The brain is subordinate to other VPS workloads. Its existing ~250 MiB peer footprint fits below
# this ceiling; pressure reclaims it before the host and bounded swap avoids disk-contention spill.
MemoryAccounting=true
MemoryHigh=320M
MemoryMax=512M
MemorySwapMax=128M
OOMPolicy=stop
KillSignal=SIGTERM
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/polymarket-bot /usr/local/lib/hermes-agent /usr/local/bin/hermes
# Hermes's native atomic auth save creates auth.json.tmp.<pid>.<uuid> beside
# auth.json before rename+directory fsync, so the parent must be writable.
# Everything model/config/state-bearing at the root remains masked below;
# only the reviewed profile is reopened inside the read-only profiles tree.
ReadWritePaths=/root/.hermes
ReadOnlyPaths=/root/.hermes/profiles
ReadWritePaths=/root/.hermes/profiles/polymarket
ReadWritePaths=/root/.hermes/auth.json
ReadWritePaths=-/root/.hermes/auth.lock
InaccessiblePaths=-/root/.ssh
InaccessiblePaths=-/root/.aws
InaccessiblePaths=-/root/.codex
InaccessiblePaths=-/root/.config
InaccessiblePaths=-/root/.gnupg
InaccessiblePaths=-/root/.kube
InaccessiblePaths=-/root/.hermes/.env
InaccessiblePaths=-/root/.hermes/SOUL.md
InaccessiblePaths=-/root/.hermes/config.yaml
InaccessiblePaths=-/root/.hermes/cron
InaccessiblePaths=-/root/.hermes/gateway.json
InaccessiblePaths=-/root/.hermes/hooks
InaccessiblePaths=-/root/.hermes/kanban
InaccessiblePaths=-/root/.hermes/memories
InaccessiblePaths=-/root/.hermes/scripts
InaccessiblePaths=-/root/.hermes/sessions
InaccessiblePaths=-/root/.hermes/skills
InaccessiblePaths=-/root/.hermes/state
InaccessiblePaths=-/root/.hermes/state.db
InaccessiblePaths=-/root/.hermes/state.db-shm
InaccessiblePaths=-/root/.hermes/state.db-wal
InaccessiblePaths=-/root/.hermes/verification_evidence.db
InaccessiblePaths=-/root/.hermes/profiles/coder
InaccessiblePaths=-/root/.hermes/profiles/memecoin-trader
InaccessiblePaths=-/root/.hermes/profiles/optionsbot
InaccessiblePaths=-/opt/polymarket-bot/config.toml
InaccessiblePaths=-/opt/polymarket-bot/.env
InaccessiblePaths=-/opt/polymarket-bot/data
InaccessiblePaths=-/etc/hermes
InaccessiblePaths=-/usr/local/lib/hermes-agent/.env
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
